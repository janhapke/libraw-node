{
  "name": "@janhapke/libraw",
  "version": "0.0.0",
  "description": "General-purpose Node.js binding for LibRaw",
  "license": "MIT",
  "repository": "github:janhapke/libraw-node",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.cjs",
  "types": "types/index.d.ts",
  "files": [
    "lib",
    "types",
    "prebuilds",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build:linux": "scripts/build-linux.sh x64",
    "gen:errors": "node scripts/gen-errors.js",
    "gen:progress": "node scripts/gen-progress.js",
    "gen:manifest": "node scripts/gen-manifest.js",
    "gen:params-cc": "node scripts/gen-params-cc.js",
    "gen:check": "node scripts/gen-errors.js --check && node scripts/gen-progress.js --check && node scripts/gen-manifest.js --check && node scripts/gen-params-cc.js --check",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-api-headers": "^1.9.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
